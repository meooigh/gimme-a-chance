#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('social:server');
var http = require('http');
var {Server} = require('socket.io');
var mysql = require('mysql2/promise');

const pool = mysql.createPool({
  host: '127.0.0.2',
  user: 'root',
  password: '123@abc',
  database: 'badass',
  multipleStatements: true,
});
/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */
var server = http.createServer(app);
var io = new Server(server, {
  pingTimeout: 60000, // 60 seconds
  pingInterval: 25000,
});
/**
 * Listen on provided port, on all network interfaces.
 */

io.on('connection', socket => {
  console.log('A user connected');

  // Extract user IDs (or peer IDs) from the handshake query
  const {idAccount, ToAccountID} = socket.handshake.query;

  // Generate a room name based on the two accounts, similar to the chat room
  const roomName = `call_${Math.min(idAccount, ToAccountID)}_${Math.max(
    idAccount,
    ToAccountID,
  )}`;
  console.log('Room Name:', roomName);

  // The user joins the room for signaling
  socket.join(roomName);
  console.log('Socket ID:', socket.id);

  // Notify the other peer in the room that a user has connected
  socket.to(roomName).emit('user-connected', socket.id);

  // Handle incoming WebRTC offer from one peer
  socket.on('offer', offer => {
    console.log('Offer received:', offer);
    // Broadcast the offer to the other peer in the room
    socket.to(roomName).emit('offer', offer);
  });

  // Handle incoming WebRTC answer from the other peer
  socket.on('answer', answer => {
    console.log('Answer received:', answer);
    // Broadcast the answer to the peer who sent the offer
    socket.to(roomName).emit('answer', answer);
  });

  // Handle ICE candidates (peer-to-peer network connectivity information)
  socket.on('icecandidate', candidate => {
    console.log('ICE Candidate received:', candidate);
    // Broadcast the ICE candidate to the other peer in the room
    socket.to(roomName).emit('icecandidate', candidate);
  });

  // Handle disconnection (both manual and automatic disconnection)
  socket.on('disconnect', reason => {
    console.log(`User disconnected: ${reason}`);
    // Notify the other peer in the room that this user disconnected
    socket.to(roomName).emit('user-disconnected', socket.id);
    socket.leave(roomName); // Leave the room on disconnection
  });

  // Chat-related logic can remain here if needed
  socket.on('send-message', async data => {
    // Broadcast the chat message to the room
    socket.to(roomName).emit('received-message', data);
    const connection = await pool.getConnection();
    console.log('-_-', data);
    try {
      await connection.beginTransaction();
      const [chatContent] = await connection.query(
        'INSERT INTO ChatContent(ContentOfChat) VALUES(?)',
        [data.message],
      );
      const ChatContentID = chatContent.insertId;
      await connection.query(
        'INSERT INTO ChatContentSend(AccountID, ChatContentID, ToAccountID) VALUES(?, ?, ?)',
        [data.idAccount, ChatContentID, data.ToAccountID],
      );

      console.log('Messages saved successfully.');
      await connection.commit();
    } catch (error) {
      await connection.rollback();
      console.error(error);
      res.status(500).json({success: false, message: 'Internal server error'});
    } finally {
      if (connection) {
        connection.release();
      }
    }
  });
});

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
